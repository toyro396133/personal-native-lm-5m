{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toyro396133.github.io/personal-native-lm-5m/lfm3-cyber/example.schema.v1.json",
  "title": "LFM3-Cyber dataset example v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scenario_id",
    "split",
    "domain",
    "task",
    "environment",
    "difficulty",
    "messages",
    "expected_skills",
    "verification",
    "source",
    "quality",
    "authorization",
    "provenance",
    "orientation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "domain": {
      "enum": [
        "fundamentals",
        "network_security",
        "soc",
        "threat_intelligence",
        "incident_response",
        "cloud_infrastructure",
        "penetration_testing",
        "application_security"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "defensive",
        "authorized_lab",
        "conceptual"
      ]
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "status"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "automated",
            "expert_review",
            "verified"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "license",
        "checked_at",
        "usage"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "usage": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "review_status",
        "notes"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "review_status": {
          "enum": [
            "pending",
            "reviewed",
            "rejected"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status"
      ],
      "properties": {
        "scope": {
          "enum": [
            "defensive",
            "authorized_lab",
            "conceptual"
          ]
        },
        "status": {
          "enum": [
            "explicit",
            "not_applicable"
          ]
        },
        "permitted_target": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_origin",
        "source_family",
        "source_usage"
      ],
      "properties": {
        "content_origin": {
          "enum": [
            "original_synthetic",
            "adapted",
            "quoted"
          ]
        },
        "source_family": {
          "type": "string"
        },
        "source_usage": {
          "type": "string"
        }
      }
    },
    "orientation": {
      "enum": [
        "defensive",
        "authorized_offensive",
        "conceptual"
      ]
    }
  }
}
